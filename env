# ────────────────────────────────────────────────────
#  이 파일을 .env 로 복사한 뒤 값을 채워 사용하세요.
#    cp env .env
#
#  .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.
#  docker compose up --build 실행 전 반드시 .env 가 있어야 합니다.
# ────────────────────────────────────────────────────

# Database
# Docker 로컬 환경에서 백엔드가 MySQL 컨테이너에 접근하기 위한 호스트명
# docker-compose.yml 이 env_file 방식으로 변경되면서 필수 항목이 됨 (기존엔 docker-compose.yml 에 하드코딩)
DB_HOST=killnagi-mysql
DB_PORT=3306
DB_NAME=killnagi
DB_USERNAME=root
DB_PASSWORD=your-db-password

# JWT
JWT_SECRET=your-jwt-secret-minimum-32-chars

# Spring Profile
# 로컬 개발 시 local 프로파일 사용 (application-local.yml 참고)
SPRING_PROFILES_ACTIVE=local

# Naver OCR
NAVER_OCR_URL=https://8civl8oe09.apigw.ntruss.com/custom/v1/50675/e1cf8b042ea7d32bc5d75f1d3cfdb30378c2a6f8f6b6073064aae21964c46d9b/general
NAVER_OCR_SECRET_KEY=your-naver-ocr-secret-key

# 파일 업로드
FILE_UPLOAD_DIR=uploads
FILE_BASE_URL=http://localhost:8080/files

# Docker image tag (로컬에서는 미사용)
IMAGE_TAG=latest