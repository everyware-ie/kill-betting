# Database
DB_NAME=killnagi
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT (최소 32자)
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# Naver OCR (선택 - 없어도 앱 기동됨)
NAVER_OCR_URL=
NAVER_OCR_SECRET_KEY=

# 파일 업로드
FILE_UPLOAD_DIR=uploads
FILE_BASE_URL=http://localhost:8080/files

# Docker image tag (CI/CD에서 자동 설정)
IMAGE_TAG=latest