# Database
DB_NAME=killnagi
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# JWT (최소 32자 이상 랜덤 문자열)
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Naver OCR (선택 - 미설정 시 OCR 기능 비활성)
NAVER_OCR_URL=
NAVER_OCR_SECRET_KEY=

# 파일 업로드
FILE_UPLOAD_DIR=uploads
FILE_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8080/files

# Docker image tag (CI/CD에서 자동 설정, 수동 배포 시 latest 사용)
IMAGE_TAG=latest