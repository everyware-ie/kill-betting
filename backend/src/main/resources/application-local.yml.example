# 이 파일을 복사해서 application-local.yml로 사용하세요.
# application-local.yml은 .gitignore에 포함되어 있습니다.
#
# 실행 방법:
#   IDE: Active Profiles = local
#   CLI: ./gradlew bootRun --args='--spring.profiles.active=local'

spring:
  jpa:
    show-sql: true

# 스키마 변경은 ddl-auto가 아닌 db/migration의 Flyway 마이그레이션 파일로 관리합니다.
# 엔티티를 바꿨다면 src/main/resources/db/migration/V{n}__description.sql을 추가하세요.

logging:
  level:
    com.killnagi: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.type.descriptor.sql.BasicBinder: trace

# 어드민 지표 대시보드(/admin) 접근 허용 이메일.
# 이 이메일로 가입/로그인한 계정만 /api/admin/** 에 접근할 수 있다.
# 비워두면 아무도 접근할 수 없다. (운영 환경은 ADMIN_EMAIL 환경변수로 주입)
admin:
  email: your-account@example.com